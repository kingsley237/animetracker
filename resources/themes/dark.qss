/* ═══════════════════════════════════════════════════════════════════════════
   Miroku — Dark Theme QSS
   Inspired by: AniList.co, Taiga, linear.app
   Palette: Deep slate bg · Indigo accent · Teal secondary · Warm amber highlight
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Global ──────────────────────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    outline: none;
}

QMainWindow, QDialog, QWidget#centralWidget {
    background-color: #0d0f14;
    color: #e2e4ec;
}

QWidget {
    background-color: transparent;
    color: #e2e4ec;
    font-size: 13px;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #090b10;
    border-right: 1px solid #1e2130;
    min-width: 232px;
    max-width: 232px;
}

QWidget#sidebarBrand {
    border-bottom: 1px solid #181b26;
    margin-bottom: 14px;
}

QLabel#sidebarLogoMark {
    background-color: #10131b;
    border: 1px solid #202436;
    border-radius: 8px;
}

QLabel#appLogo {
    font-size: 17px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: 1px;
    padding: 0;
}

QLabel#appLogoSub {
    font-size: 11px;
    color: #6f768b;
    letter-spacing: 0;
    padding: 0;
}

QPushButton#navBtn {
    background: transparent;
    border: 1px solid transparent;
    color: #8a91a6;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 8px 10px;
    border-radius: 7px;
    min-height: 20px;
}

QPushButton#navBtn:hover {
    background-color: #11141d;
    color: #d5d8e4;
    border-color: #202436;
}

QPushButton#navBtn[active="true"] {
    background-color: #151928;
    color: #f2f3f8;
    border-color: #2c3350;
    font-weight: 600;
}

QWidget#sidebarSection {
    padding: 8px 20px 4px;
}

QLabel#sidebarSectionLabel {
    font-size: 10px;
    color: #4e566d;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    padding: 2px 10px 0;
}

/* ── Status bar ──────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #080a0e;
    color: #4a5070;
    font-size: 11px;
    border-top: 1px solid #1a1d28;
    min-height: 24px;
}

QLabel#connStatus {
    font-size: 11px;
    padding: 0 12px;
}

/* ── Content area ────────────────────────────────────────────────────────── */
QWidget#contentArea {
    background-color: #0d0f14;
}

QWidget#pageHeader {
    background-color: transparent;
    border-bottom: 1px solid #1a1d28;
    padding: 0 0 16px;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.3px;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #4a5070;
}

/* ── Search bar ──────────────────────────────────────────────────────────── */
QLineEdit#searchBar {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 8px;
    padding: 8px 14px 8px 38px;
    color: #e2e4ec;
    font-size: 13px;
    selection-background-color: #4b3fa8;
}

QLineEdit#searchBar:focus {
    border-color: #4b3fa8;
    background-color: #161a24;
}

QLineEdit#searchBar::placeholder {
    color: #3a3f55;
}

/* ── Filter pills ────────────────────────────────────────────────────────── */
QPushButton#filterPill {
    background-color: #131620;
    border: 1.5px solid #1e2130;
    border-radius: 14px;
    color: #6b7280;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 18px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#filterPill:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #c7cbd9;
}

QPushButton#filterPill[active="true"] {
    background-color: #1e1847;
    border-color: #7c6af7;
    color: #c4b8ff;
    font-weight: 600;
}

/* ── Anime card grid ─────────────────────────────────────────────────────── */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background: #0a0c10;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2a2d42;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4b3fa8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: #0a0c10;
    height: 6px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #2a2d42;
    border-radius: 3px;
    min-width: 30px;
}

/* ── Anime card (background + border in paintEvent; mask clips corners) ─── */
QFrame#animeCard {
    background: transparent;
    border: none;
}

QLabel#cardCover {
    background-color: transparent;
    border: none;
}

QLabel#cardTitle {
    font-size: 12px;
    font-weight: 700;
    color: #f0f1f5;
    background: transparent;
}

QLabel#cardEpisode {
    font-size: 10px;
    color: #c0c4d6;
    background: transparent;
}

QLabel#cardCountdown {
    font-size: 10px;
    font-weight: 600;
    background: transparent;
}
/* ── Status badges ───────────────────────────────────────────────────────── */
QLabel#badgeWatching {
    background-color: #0e2a1f;
    color: #34d399;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgeCompleted {
    background-color: #1a1847;
    color: #a594f9;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgePlanned {
    background-color: rgba(6, 8, 16, 0.94);
    color: #f4f2ff;
    border: 1px solid #9d8fff;
    border-radius: 4px;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 8px;
    letter-spacing: 0.6px;
}

QLabel#badgeUpcoming {
    background-color: #1f1a0d;
    color: #fbbf24;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgeAlert {
    background-color: #2a1010;
    color: #f87171;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

/* ── Progress bar ────────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #1a1d28;
    border: none;
    border-radius: 3px;
    height: 4px;
    text-align: center;
    font-size: 0px;
}

QProgressBar::chunk {
    background-color: #7c6af7;
    border-radius: 3px;
}

QProgressBar[status="completed"]::chunk {
    background-color: #34d399;
}

QProgressBar[status="upcoming"]::chunk {
    background-color: #fbbf24;
}

/* ── Detail panel ────────────────────────────────────────────────────────── */
QWidget#detailPanel {
    background-color: #0a0c10;
    border-left: 1px solid #1a1d28;
    min-width: 390px;
    max-width: 390px;
}

QLabel#detailPanelTitle {
    font-size: 13px;
    font-weight: 700;
    color: #dfe2ec;
}

QLabel#detailHeroBanner,
QWidget#detailBanner {
    background-color: #1a1d28;
    border-radius: 8px;
    min-height: 132px;
    max-height: 132px;
}

QFrame#detailSummaryCard,
QFrame#detailCard {
    background-color: #111420;
    border: 1px solid #1e2235;
    border-radius: 8px;
}

QLabel#detailCover {
    background-color: #1a1d28;
    border: 1px solid #2a2f45;
    border-radius: 8px;
}

QLabel#detailBannerImg {
    min-height: 160px;
    max-height: 160px;
}

QLabel#detailTitle {
    font-size: 18px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.2px;
}

QLabel#detailEngTitle {
    font-size: 12px;
    color: #7f879d;
}

QLabel#detailStudio {
    font-size: 11px;
    color: #626a80;
}

QFrame#detailMetricBox {
    background-color: #0d0f14;
    border: 1px solid #1e2235;
    border-radius: 7px;
    min-width: 58px;
    max-width: 68px;
}

QLabel#detailScore {
    font-size: 22px;
    font-weight: 700;
    color: #7c6af7;
}

QLabel#detailScoreLabel {
    font-size: 11px;
    color: #4a5070;
}

QLabel#detailMeta {
    font-size: 12px;
    color: #8a91a6;
    line-height: 1.6;
}

QLabel#detailProgressCard {
    background-color: #151929;
    border: 1px solid #252a46;
    border-radius: 8px;
    color: #b9adff;
    font-size: 12px;
    line-height: 1.7;
    padding: 10px 14px;
}

QLabel#detailSectionLabel {
    font-size: 10px;
    color: #4e566d;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
}

QLabel#detailSynopsis {
    font-size: 12px;
    color: #8b90a6;
    line-height: 1.65;
}

QLabel#detailRatingHint {
    font-size: 12px;
    color: #626a80;
    margin-left: 6px;
}

/* ── Genre chips ─────────────────────────────────────────────────────────── */
QLabel#genreChip {
    background-color: #151929;
    color: #7c6af7;
    border: 1px solid #2a2550;
    border-radius: 12px;
    font-size: 11px;
    padding: 3px 10px;
}

/* ── Episode list ────────────────────────────────────────────────────────── */
QScrollArea#episodeScroll {
    background-color: transparent;
    border: none;
}

QFrame#episodeRow {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 7px;
    padding: 2px;
}

QFrame#episodeRow:hover {
    background-color: #141828;
    border-color: #252a40;
}

QLabel#epNum {
    font-size: 12px;
    font-weight: 600;
    color: #4a5070;
    min-width: 28px;
}

QLabel#epStatus {
    font-size: 11px;
    font-weight: 600;
}

/* ── Rating widget ───────────────────────────────────────────────────────── */
QPushButton#starBtn {
    background: transparent;
    border: none;
    font-size: 20px;
    color: #2a2d42;
    padding: 2px;
}

QPushButton#starBtn:hover {
    color: #fbbf24;
}

QPushButton#starBtn[rated="true"] {
    color: #fbbf24;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */
QPushButton#primaryBtn {
    background-color: #4b3fa8;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 9px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background-color: #5a4fc4;
}

QPushButton#primaryBtn:pressed {
    background-color: #3d3394;
}

QPushButton#primaryBtn:disabled {
    background-color: #1e2130;
    color: #3a3f55;
}

QPushButton#secondaryBtn {
    background-color: #131620;
    color: #9da5c0;
    border: 1px solid #1e2130;
    border-radius: 8px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#secondaryBtn:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #c7cbd9;
}

QPushButton#dangerBtn {
    background-color: transparent;
    color: #f87171;
    border: 1px solid #3a1a1a;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#dangerBtn:hover {
    background-color: #2a1010;
    border-color: #f87171;
}

QPushButton#iconBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px;
    color: #4a5070;
    font-size: 16px;
}

QPushButton#iconBtn:hover {
    background-color: #151929;
    color: #9da5c0;
}

/* ── Tab bar ─────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: transparent;
    color: #4a5070;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #a594f9;
    border-bottom-color: #7c6af7;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #9da5c0;
}

/* ── Combo box ───────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #9da5c0;
    padding: 7px 12px;
    font-size: 12px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #2e3354;
}

QComboBox:focus {
    border-color: #4b3fa8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #131620;
    border: 1px solid #2a2d42;
    border-radius: 7px;
    color: #9da5c0;
    selection-background-color: #1e1847;
    selection-color: #a594f9;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 4px;
}

/* ── Spinbox ─────────────────────────────────────────────────────────────── */
QSpinBox {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #e2e4ec;
    padding: 6px 10px;
    font-size: 13px;
}

QSpinBox:focus {
    border-color: #4b3fa8;
}

/* ── Line edit ───────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #e2e4ec;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #4b3fa8;
}

QLineEdit:focus {
    border-color: #4b3fa8;
}

/* ── Text edit ───────────────────────────────────────────────────────────── */
QTextEdit {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #9da5c0;
    padding: 8px;
    font-size: 12px;
    selection-background-color: #4b3fa8;
}

QTextEdit:focus {
    border-color: #4b3fa8;
}

/* ── Checkboxes ──────────────────────────────────────────────────────────── */
QCheckBox {
    color: #9da5c0;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2a2d42;
    border-radius: 4px;
    background-color: #131620;
}

QCheckBox::indicator:checked {
    background-color: #4b3fa8;
    border-color: #4b3fa8;
}

QCheckBox::indicator:hover {
    border-color: #4b3fa8;
}

/* ── Tooltip ─────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1a1d28;
    color: #c7cbd9;
    border: 1px solid #2a2d42;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Dialog ──────────────────────────────────────────────────────────────── */
QDialog {
    background-color: #0f1118;
}

QLabel#dialogTitle {
    font-size: 17px;
    font-weight: 700;
    color: #f0f1f5;
}

QLabel#dialogSubtitle {
    font-size: 13px;
    color: #4a5070;
}

/* Settings dialog */
QDialog#settingsDialog {
    background-color: #0d0f14;
}

QWidget#settingsNav {
    background-color: #090b10;
    border-right: 1px solid #1e2130;
    min-width: 204px;
    max-width: 204px;
}

QWidget#settingsBody {
    background-color: #0d0f14;
}

QLabel#settingsNavBrand {
    font-size: 18px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: 1px;
}

QLabel#settingsNavCaption,
QLabel#settingsNavVersion {
    font-size: 12px;
    color: #626a80;
}

QPushButton#settingsNavBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: #8a91a6;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 9px 11px;
}

QPushButton#settingsNavBtn:hover {
    background-color: #11141d;
    border-color: #202436;
    color: #d5d8e4;
}

QPushButton#settingsNavBtn[active="true"] {
    background-color: #151928;
    border-color: #2c3350;
    color: #f2f3f8;
    font-weight: 600;
}

QLabel#settingsTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f0f1f5;
}

QLabel#settingsSubtitle,
QLabel#settingsPageSubtitle,
QLabel#settingsBodyText {
    font-size: 13px;
    color: #8a91a6;
    line-height: 1.55;
}

QLabel#settingsPageTitle {
    font-size: 18px;
    font-weight: 700;
    color: #f0f1f5;
}

QFrame#settingsCard {
    background-color: #111420;
    border: 1px solid #1e2235;
    border-radius: 8px;
}

QLabel#settingsCardTitle {
    font-size: 13px;
    font-weight: 700;
    color: #dfe2ec;
}

QLabel#settingsHelperText,
QLabel#settingsMutedText {
    font-size: 12px;
    color: #626a80;
}

QLabel#settingsValueText {
    font-size: 13px;
    color: #c7cbd9;
    font-weight: 600;
}

QLabel#settingsGoodText {
    font-size: 13px;
    color: #34d399;
    font-weight: 600;
}

QLabel#settingsBadText {
    font-size: 13px;
    color: #f87171;
    font-weight: 600;
}

QLabel#settingsPathText {
    background-color: #0d0f14;
    border: 1px solid #1e2235;
    border-radius: 6px;
    color: #8a91a6;
    font-family: "Consolas", "JetBrains Mono", monospace;
    font-size: 11px;
    padding: 8px 10px;
}

QLabel#settingsAboutName {
    font-size: 24px;
    font-weight: 700;
    color: #f0f1f5;
}

/* ── Stats cards ─────────────────────────────────────────────────────────── */
QFrame#statCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
    padding: 6px;
    min-height: 64px;
}

QLabel#statValue {
    font-size: 26px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.5px;
    min-height: 32px;
}

QLabel#statLabel {
    font-size: 11px;
    color: #4a5070;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

/* ── Discover card ───────────────────────────────────────────────────────── */
QFrame#discoverCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
}

QFrame#discoverCard:hover {
    border-color: #2e3354;
}

/* ── Separator ───────────────────────────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #1a1d28;
}

/* ── Splitter ────────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #1a1d28;
    width: 1px;
}

/* ── Message box ─────────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #0f1118;
}

QMessageBox QLabel {
    color: #e2e4ec;
    font-size: 13px;
}


/* ── Discover card buttons — guaranteed readable ────────────────────────── */
QFrame#discoverCard QPushButton {
    min-width: 52px !important;
    min-height: 26px !important;
    padding: 5px 14px !important;
    font-size: 11px;
    border-radius: 6px;
}

/* ── Library stat card values always visible ─────────────────────────────── */
QFrame#statCard QLabel {
    color: inherit;
}

/* Apply btn fix */
QPushButton#secondaryBtn {
    color: #c7cbd9 !important;
}
QPushButton#filterPill {
    color: #9da5c0 !important;
}

/* ── Progress bar: unwatched alert state ─────────────────────────────────── */
QProgressBar[status="alert"]::chunk {
    background-color: #f87171;
    border-radius: 3px;
}

/* ── Cover overlay badges ────────────────────────────────────────────────── */
QLabel#coverScoreBadge {
    background-color: rgba(18, 14, 40, 0.86);
    color: #c4b8ff;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 2px;
    border: 1px solid rgba(124, 106, 247, 0.45);
}

QLabel#coverEpBadge {
    background-color: rgba(18, 14, 40, 0.86);
    color: #e2e4ec;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 2px;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QLabel#coverBehindBadge {
    background-color: rgba(22, 16, 0, 0.90);
    color: #fbbf24;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 2px;
    border: 1px solid rgba(251, 191, 36, 0.40);
}

/* ── Behind filter pill — amber tint, set via objectName ────────────────── */
QPushButton#filterPillBehind {
    background-color: #1a1500;
    border: 1.5px solid #78560a;
    border-radius: 14px;
    color: #d97706;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 18px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#filterPillBehind:hover {
    background-color: #221b00;
    border-color: #b45309;
    color: #fbbf24;
}

QPushButton#filterPillBehind[active="true"] {
    background-color: #2a2000;
    border-color: #fbbf24;
    color: #fde68a;
    font-weight: 600;
}

/* ── Section headers in grouped library view ────────────────────────────── */
QLabel#libSectionHeader {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    background: transparent;
    padding: 16px 0 8px 0;
    color: #4a5070;
}

QFrame#statsPageCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
}


/* ── Hero card (#1 entry) ────────────────────────────────────────────────── */
QFrame#hofHeroCard {
    background-color: #0f1118;
    border: 1px solid #fbbf2430;
    border-radius: 12px;
}

QFrame#hofHeroCard:hover {
    border-color: #fbbf2466;
}

/* ── Rich list row ───────────────────────────────────────────────────────── */
QFrame#hofRowCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
}

QFrame#hofRowCard:hover {
    background-color: #141828;
    border-color: #2e3354;
}

/* ── Grid card ───────────────────────────────────────────────────────────── */
QFrame#hofGridCard {
    background-color: #111420;
    border: none;
    border-radius: 10px;
}

QFrame#hofGridCard:hover {
    border: 2px solid #4b3fa8;
}


