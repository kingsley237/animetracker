/* ═══════════════════════════════════════════════════════════════════════════
   AnimeTracker — Dark Theme QSS
   Inspired by: AniList.co, Taiga, linear.app
   Palette: Deep slate bg · Indigo accent · Teal secondary · Warm amber highlight
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Global ──────────────────────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    outline: none;
}

QMainWindow, QDialog, QWidget#centralWidget {
    background-color: #0d0f14;
    color: #e2e4ec;
}

QWidget {
    background-color: transparent;
    color: #e2e4ec;
    font-size: 13px;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #0a0c10;
    border-right: 1px solid #1e2130;
    min-width: 200px;
    max-width: 200px;
}

QLabel#appLogo {
    font-size: 18px;
    font-weight: 700;
    color: #7c6af7;
    letter-spacing: 1px;
    padding: 0;
}

QLabel#appLogoSub {
    font-size: 9px;
    color: #4a5070;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 0;
}

QPushButton#navBtn {
    background: transparent;
    border: none;
    color: #6b7280;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 10px 20px 10px 16px;
    border-radius: 0;
    border-left: 3px solid transparent;
}

QPushButton#navBtn:hover {
    background-color: #131620;
    color: #c7cbd9;
    border-left-color: #2e3354;
}

QPushButton#navBtn[active="true"] {
    background-color: #151929;
    color: #a594f9;
    border-left-color: #7c6af7;
    font-weight: 600;
}

QWidget#sidebarSection {
    padding: 8px 20px 4px;
}

QLabel#sidebarSectionLabel {
    font-size: 10px;
    color: #3b4260;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
}

/* ── Status bar ──────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #080a0e;
    color: #4a5070;
    font-size: 11px;
    border-top: 1px solid #1a1d28;
    min-height: 24px;
}

QLabel#connStatus {
    font-size: 11px;
    padding: 0 12px;
}

/* ── Content area ────────────────────────────────────────────────────────── */
QWidget#contentArea {
    background-color: #0d0f14;
}

QWidget#pageHeader {
    background-color: transparent;
    border-bottom: 1px solid #1a1d28;
    padding: 0 0 16px;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.3px;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #4a5070;
}

/* ── Search bar ──────────────────────────────────────────────────────────── */
QLineEdit#searchBar {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 8px;
    padding: 8px 14px 8px 38px;
    color: #e2e4ec;
    font-size: 13px;
    selection-background-color: #4b3fa8;
}

QLineEdit#searchBar:focus {
    border-color: #4b3fa8;
    background-color: #161a24;
}

QLineEdit#searchBar::placeholder {
    color: #3a3f55;
}

/* ── Filter pills ────────────────────────────────────────────────────────── */
QPushButton#filterPill {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 16px;
    color: #6b7280;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 14px;
}

QPushButton#filterPill:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #9da5c0;
}

QPushButton#filterPill[active="true"] {
    background-color: #1e1847;
    border-color: #4b3fa8;
    color: #a594f9;
}

/* ── Anime card grid ─────────────────────────────────────────────────────── */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background: #0a0c10;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2a2d42;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4b3fa8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: #0a0c10;
    height: 6px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #2a2d42;
    border-radius: 3px;
    min-width: 30px;
}

/* ── Anime card ──────────────────────────────────────────────────────────── */
/* ── Base card ───────────────────────────────────────────────────────────── */
QFrame#animeCard {
    background-color: #111420;
    border: 1.5px solid #1e2235;
    border-radius: 10px;
}

/* ── Hover — clearly brighter border + subtle bg lift ───────────────────── */
QFrame#animeCard:hover {
    border: 2px solid #3d4270;
    background-color: #141828;
}

/* ── Selected/active — strong purple border, elevated bg ────────────────── */
QFrame#animeCard[selected="true"] {
    border: 2.5px solid #7c6af7;
    background-color: #181c30;
}

QFrame#animeCard[selected="true"]:hover {
    border: 2.5px solid #9d8fff;
    background-color: #1c2038;
}

QLabel#cardCover {
    border-radius: 8px 8px 0 0;
    background-color: #1a1d28;
}

QLabel#cardTitle {
    font-size: 13px;
    font-weight: 600;
    color: #dde0ed;
}

QLabel#cardSubtitle {
    font-size: 11px;
    color: #4a5070;
}

QLabel#cardEpisode {
    font-size: 11px;
    color: #7c6af7;
    font-weight: 500;
}

QLabel#cardCountdown {
    font-size: 11px;
    font-weight: 600;
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
}

QWidget#cardBadge {
    border-radius: 4px;
    padding: 2px 6px;
}

/* ── Status badges ───────────────────────────────────────────────────────── */
QLabel#badgeWatching {
    background-color: #0e2a1f;
    color: #34d399;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgeCompleted {
    background-color: #1a1847;
    color: #a594f9;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgePlanned {
    background-color: #1a1e2e;
    color: #6b7280;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgeUpcoming {
    background-color: #1f1a0d;
    color: #fbbf24;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgeAlert {
    background-color: #2a1010;
    color: #f87171;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

/* ── Progress bar ────────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #1a1d28;
    border: none;
    border-radius: 3px;
    height: 4px;
    text-align: center;
    font-size: 0px;
}

QProgressBar::chunk {
    background-color: #7c6af7;
    border-radius: 3px;
}

QProgressBar[status="completed"]::chunk {
    background-color: #34d399;
}

QProgressBar[status="upcoming"]::chunk {
    background-color: #fbbf24;
}

/* ── Detail panel ────────────────────────────────────────────────────────── */
QWidget#detailPanel {
    background-color: #0a0c10;
    border-left: 1px solid #1a1d28;
    min-width: 340px;
    max-width: 380px;
}

QWidget#detailBanner {
    background-color: #1a1d28;
    min-height: 160px;
    max-height: 160px;
}

QLabel#detailBannerImg {
    min-height: 160px;
    max-height: 160px;
}

QLabel#detailTitle {
    font-size: 17px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.2px;
}

QLabel#detailEngTitle {
    font-size: 12px;
    color: #4a5070;
}

QLabel#detailScore {
    font-size: 22px;
    font-weight: 700;
    color: #7c6af7;
}

QLabel#detailScoreLabel {
    font-size: 11px;
    color: #4a5070;
}

QLabel#detailMeta {
    font-size: 12px;
    color: #6b7280;
    line-height: 1.6;
}

QLabel#detailSynopsis {
    font-size: 12px;
    color: #8b90a6;
    line-height: 1.65;
}

/* ── Genre chips ─────────────────────────────────────────────────────────── */
QLabel#genreChip {
    background-color: #151929;
    color: #7c6af7;
    border: 1px solid #2a2550;
    border-radius: 12px;
    font-size: 11px;
    padding: 3px 10px;
}

/* ── Episode list ────────────────────────────────────────────────────────── */
QScrollArea#episodeScroll {
    background-color: transparent;
    border: none;
}

QFrame#episodeRow {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 7px;
    padding: 2px;
}

QFrame#episodeRow:hover {
    background-color: #141828;
    border-color: #252a40;
}

QLabel#epNum {
    font-size: 12px;
    font-weight: 600;
    color: #4a5070;
    min-width: 28px;
}

QLabel#epStatus {
    font-size: 11px;
    font-weight: 600;
}

/* ── Rating widget ───────────────────────────────────────────────────────── */
QPushButton#starBtn {
    background: transparent;
    border: none;
    font-size: 20px;
    color: #2a2d42;
    padding: 2px;
}

QPushButton#starBtn:hover {
    color: #fbbf24;
}

QPushButton#starBtn[rated="true"] {
    color: #fbbf24;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */
QPushButton#primaryBtn {
    background-color: #4b3fa8;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 9px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background-color: #5a4fc4;
}

QPushButton#primaryBtn:pressed {
    background-color: #3d3394;
}

QPushButton#primaryBtn:disabled {
    background-color: #1e2130;
    color: #3a3f55;
}

QPushButton#secondaryBtn {
    background-color: #131620;
    color: #9da5c0;
    border: 1px solid #1e2130;
    border-radius: 8px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#secondaryBtn:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #c7cbd9;
}

QPushButton#dangerBtn {
    background-color: transparent;
    color: #f87171;
    border: 1px solid #3a1a1a;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#dangerBtn:hover {
    background-color: #2a1010;
    border-color: #f87171;
}

QPushButton#iconBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px;
    color: #4a5070;
    font-size: 16px;
}

QPushButton#iconBtn:hover {
    background-color: #151929;
    color: #9da5c0;
}

/* ── Tab bar ─────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: transparent;
    color: #4a5070;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #a594f9;
    border-bottom-color: #7c6af7;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #9da5c0;
}

/* ── Combo box ───────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #9da5c0;
    padding: 7px 12px;
    font-size: 12px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #2e3354;
}

QComboBox:focus {
    border-color: #4b3fa8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #131620;
    border: 1px solid #2a2d42;
    border-radius: 7px;
    color: #9da5c0;
    selection-background-color: #1e1847;
    selection-color: #a594f9;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 4px;
}

/* ── Spinbox ─────────────────────────────────────────────────────────────── */
QSpinBox {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #e2e4ec;
    padding: 6px 10px;
    font-size: 13px;
}

QSpinBox:focus {
    border-color: #4b3fa8;
}

/* ── Line edit ───────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #e2e4ec;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #4b3fa8;
}

QLineEdit:focus {
    border-color: #4b3fa8;
}

/* ── Text edit ───────────────────────────────────────────────────────────── */
QTextEdit {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #9da5c0;
    padding: 8px;
    font-size: 12px;
    selection-background-color: #4b3fa8;
}

QTextEdit:focus {
    border-color: #4b3fa8;
}

/* ── Checkboxes ──────────────────────────────────────────────────────────── */
QCheckBox {
    color: #9da5c0;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2a2d42;
    border-radius: 4px;
    background-color: #131620;
}

QCheckBox::indicator:checked {
    background-color: #4b3fa8;
    border-color: #4b3fa8;
}

QCheckBox::indicator:hover {
    border-color: #4b3fa8;
}

/* ── Tooltip ─────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1a1d28;
    color: #c7cbd9;
    border: 1px solid #2a2d42;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Dialog ──────────────────────────────────────────────────────────────── */
QDialog {
    background-color: #0f1118;
}

QLabel#dialogTitle {
    font-size: 17px;
    font-weight: 700;
    color: #f0f1f5;
}

QLabel#dialogSubtitle {
    font-size: 13px;
    color: #4a5070;
}

/* ── Stats cards ─────────────────────────────────────────────────────────── */
QFrame#statCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
    padding: 6px;
    min-height: 64px;
}

QLabel#statValue {
    font-size: 26px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.5px;
    min-height: 32px;
}

QLabel#statLabel {
    font-size: 11px;
    color: #4a5070;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

/* ── Discover card ───────────────────────────────────────────────────────── */
QFrame#discoverCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
}

QFrame#discoverCard:hover {
    border-color: #2e3354;
}

/* ── Separator ───────────────────────────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #1a1d28;
}

/* ── Splitter ────────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #1a1d28;
    width: 1px;
}

/* ── Message box ─────────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #0f1118;
}

QMessageBox QLabel {
    color: #e2e4ec;
    font-size: 13px;
}


/* ── Discover card buttons — guaranteed readable ────────────────────────── */
QFrame#discoverCard QPushButton {
    min-width: 52px !important;
    min-height: 26px !important;
    padding: 5px 14px !important;
    font-size: 11px;
    border-radius: 6px;
}

/* ── Library stat card values always visible ─────────────────────────────── */
QFrame#statCard QLabel {
    color: inherit;
}

/* Apply btn fix */
QPushButton#secondaryBtn {
    color: #c7cbd9 !important;
}
QPushButton#filterPill {
    color: #9da5c0 !important;
}

/* ── Unwatched card — red border all sides, highly visible ──────────────── */
QFrame#animeCard[hasUnwatched="true"] {
    background-color: #160f0f;
    border: 2px solid #7f1d1d;
    border-left: 4px solid #f87171;
    border-radius: 10px;
}

/* ── Unwatched + hover — brighter red so it's still visible ─────────────── */
QFrame#animeCard[hasUnwatched="true"]:hover {
    background-color: #1c1010;
    border: 2px solid #ef4444;
    border-left: 4px solid #ff6b6b;
}

/* ── Unwatched + selected — keep red visible even when active ───────────── */
QFrame#animeCard[hasUnwatched="true"][selected="true"] {
    background-color: #1a1020;
    border: 2.5px solid #ef4444;
    border-left: 4px solid #ff6b6b;
}

/* ── Progress bar: unwatched alert state ─────────────────────────────────── */
QProgressBar[status="alert"]::chunk {
    background-color: #f87171;
    border-radius: 3px;
}
