/* ═══════════════════════════════════════════════════════════════════════════
   Miroku — Dark Theme QSS
   Inspired by: AniList.co, Taiga, linear.app
   Palette: Deep slate bg · Indigo accent · Teal secondary · Warm amber highlight
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Global ──────────────────────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    outline: none;
}

QMainWindow, QDialog, QWidget#centralWidget {
    background-color: #0d0f14;
    color: #e2e4ec;
}

QWidget {
    background-color: transparent;
    color: #e2e4ec;
    font-size: 13px;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #090b10;
    border-right: 1px solid #1e2130;
    min-width: 232px;
    max-width: 232px;
}

QWidget#sidebarBrand {
    border-bottom: 1px solid #181b26;
    margin-bottom: 14px;
}

QLabel#sidebarLogoMark {
    background-color: #10131b;
    border: 1px solid #202436;
    border-radius: 8px;
}

QLabel#appLogo {
    font-size: 17px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: 1px;
    padding: 0;
}

QLabel#appLogoSub {
    font-size: 11px;
    color: #6f768b;
    letter-spacing: 0;
    padding: 0;
}

QPushButton#navBtn {
    background: transparent;
    border: 1px solid transparent;
    color: #8a91a6;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 8px 10px;
    border-radius: 7px;
    min-height: 20px;
}

QPushButton#navBtn:hover {
    background-color: #11141d;
    color: #d5d8e4;
    border-color: #202436;
}

QPushButton#navBtn[active="true"] {
    background-color: #151928;
    color: #f2f3f8;
    border-color: #2c3350;
    font-weight: 600;
}

QWidget#sidebarSection {
    padding: 8px 20px 4px;
}

QLabel#sidebarSectionLabel {
    font-size: 10px;
    color: #4e566d;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    padding: 2px 10px 0;
}

/* ── Status bar ──────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #080a0e;
    color: #4a5070;
    font-size: 11px;
    border-top: 1px solid #1a1d28;
    min-height: 24px;
}

QLabel#connStatus {
    font-size: 11px;
    padding: 0 12px;
}

/* ── Content area ────────────────────────────────────────────────────────── */
QWidget#contentArea {
    background-color: #0d0f14;
}

QWidget#pageHeader {
    background-color: transparent;
    border-bottom: 1px solid #1a1d28;
    padding: 0 0 16px;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.3px;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #4a5070;
}

/* ── Search bar ──────────────────────────────────────────────────────────── */
QLineEdit#searchBar {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 8px;
    padding: 8px 14px 8px 38px;
    color: #e2e4ec;
    font-size: 13px;
    selection-background-color: #4b3fa8;
}

QLineEdit#searchBar:focus {
    border-color: #4b3fa8;
    background-color: #161a24;
}

QLineEdit#searchBar::placeholder {
    color: #3a3f55;
}

/* ── Filter pills ────────────────────────────────────────────────────────── */
QPushButton#filterPill {
    background-color: #131620;
    border: 1.5px solid #1e2130;
    border-radius: 14px;
    color: #6b7280;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 18px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#filterPill:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #c7cbd9;
}

QPushButton#filterPill[active="true"] {
    background-color: #1e1847;
    border-color: #7c6af7;
    color: #c4b8ff;
    font-weight: 600;
}

/* ── Anime card grid ─────────────────────────────────────────────────────── */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background: #0a0c10;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2a2d42;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4b3fa8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: #0a0c10;
    height: 6px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #2a2d42;
    border-radius: 3px;
    min-width: 30px;
}

/* ── Anime card (background + border in paintEvent; mask clips corners) ─── */
QFrame#animeCard {
    background: transparent;
    border: none;
}

QLabel#cardCover {
    background-color: transparent;
    border: none;
}

QLabel#cardTitle {
    font-size: 12px;
    font-weight: 700;
    color: #f0f1f5;
    background: transparent;
}

QLabel#cardEpisode {
    font-size: 10px;
    color: #c0c4d6;
    background: transparent;
}

QLabel#cardCountdown {
    font-size: 10px;
    font-weight: 600;
    background: transparent;
}
/* ── Status badges ───────────────────────────────────────────────────────── */
QLabel#badgeWatching {
    background-color: #0e2a1f;
    color: #34d399;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgeCompleted {
    background-color: #1a1847;
    color: #a594f9;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgePlanned {
    background-color: rgba(6, 8, 16, 0.94);
    color: #f4f2ff;
    border: 1px solid #9d8fff;
    border-radius: 4px;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 8px;
    letter-spacing: 0.6px;
}

QLabel#badgeUpcoming {
    background-color: #1f1a0d;
    color: #fbbf24;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

QLabel#badgeAlert {
    background-color: #2a1010;
    color: #f87171;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 0.5px;
}

/* ── Progress bar ────────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #1a1d28;
    border: none;
    border-radius: 3px;
    height: 4px;
    text-align: center;
    font-size: 0px;
}

QProgressBar::chunk {
    background-color: #7c6af7;
    border-radius: 3px;
}

QProgressBar[status="completed"]::chunk {
    background-color: #34d399;
}

QProgressBar[status="upcoming"]::chunk {
    background-color: #fbbf24;
}

/* ── Detail panel ────────────────────────────────────────────────────────── */
QWidget#detailPanel {
    background-color: #0a0c10;
    border-left: 1px solid #1a1d28;
    min-width: 390px;
    max-width: 390px;
}

QLabel#detailPanelTitle {
    font-size: 13px;
    font-weight: 700;
    color: #dfe2ec;
}

QLabel#detailHeroBanner,
QWidget#detailBanner {
    background-color: #1a1d28;
    border-radius: 8px;
    min-height: 132px;
    max-height: 132px;
}

QFrame#detailSummaryCard,
QFrame#detailCard {
    background-color: #111420;
    border: none;
    border-radius: 8px;
    padding: 0px;
}

QLabel#detailCover {
    background-color: #1a1d28;
    border: 1px solid #2a2f45;
    border-radius: 8px;
}

QLabel#detailBannerImg {
    min-height: 160px;
    max-height: 160px;
}

QLabel#detailTitle {
    font-size: 18px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.2px;
}

QLabel#detailEngTitle {
    font-size: 12px;
    color: #7f879d;
}

QLabel#detailStudio {
    font-size: 11px;
    color: #626a80;
}

QFrame#detailMetricBox {
    background-color: #0d0f14;
    border: none;
    border-radius: 7px;
    min-width: 58px;
    max-width: 68px;
}

QLabel#detailScore {
    font-size: 22px;
    font-weight: 700;
    color: #7c6af7;
}

QLabel#detailScoreLabel {
    font-size: 11px;
    color: #4a5070;
}

QLabel#detailMeta {
    font-size: 12px;
    color: #8a91a6;
    line-height: 1.6;
}

QLabel#detailProgressCard {
    background-color: #151929;
    border: 1px solid #252a46;
    border-radius: 8px;
    color: #b9adff;
    font-size: 12px;
    line-height: 1.7;
    padding: 10px 14px;
}

QLabel#detailSectionLabel {
    font-size: 10px;
    color: #4e566d;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
}

QLabel#detailSynopsis {
    font-size: 12px;
    color: #8b90a6;
    line-height: 1.65;
}

QLabel#detailRatingHint {
    font-size: 12px;
    color: #626a80;
    margin-left: 6px;
}

/* ── Genre chips ─────────────────────────────────────────────────────────── */
QLabel#genreChip {
    background-color: #151929;
    color: #7c6af7;
    border: 1px solid #2a2550;
    border-radius: 12px;
    font-size: 11px;
    padding: 3px 10px;
}

/* ── Episode list ────────────────────────────────────────────────────────── */
QScrollArea#episodeScroll {
    background-color: transparent;
    border: none;
}

QFrame#episodeRow {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 7px;
    padding: 2px;
}

QFrame#episodeRow:hover {
    background-color: #141828;
    border-color: #252a40;
}

QLabel#epNum {
    background: transparent;
    border: none;
    font-size: 12px;
    font-weight: 600;
    color: #9da5c0;
    min-width: 28px;
    padding: 0px;
    margin: 0px;
}

QLabel#epStatus {
    font-size: 11px;
    font-weight: 600;
}

/* ── Rating widget ───────────────────────────────────────────────────────── */
QPushButton#starBtn {
    background: transparent;
    border: none;
    font-size: 20px;
    color: #2a2d42;
    padding: 2px;
    min-width: 20px;
    min-height: 20px;
}

QPushButton#starBtn:hover {
    color: #fbbf24;
}

QPushButton#starBtn[rated="true"] {
    color: #fbbf24;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */
QPushButton#primaryBtn {
    background-color: #4b3fa8;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 9px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background-color: #5a4fc4;
}

QPushButton#primaryBtn:pressed {
    background-color: #3d3394;
}

QPushButton#primaryBtn:disabled {
    background-color: #1e2130;
    color: #3a3f55;
}

QPushButton#secondaryBtn {
    background-color: #131620;
    color: #9da5c0;
    border: 1px solid #1e2130;
    border-radius: 8px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#secondaryBtn:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #c7cbd9;
}

QPushButton#anilistAvatarBtn {
    background-color: transparent;
    border: 2px solid #2c3350;
    border-radius: 20px;
    padding: 0;
}

QPushButton#anilistAvatarBtn:hover {
    border-color: #4b3fa8;
    background-color: #151928;
}

QPushButton#anilistUserNameBtn {
    background: transparent;
    border: none;
    color: #c7cbd9;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 4px;
    text-align: left;
}

QPushButton#anilistUserNameBtn:hover {
    color: #f0f1f5;
    text-decoration: underline;
}

QPushButton#anilistConnectBtn {
    background-color: #1a1d28;
    color: #c7cbd9;
    border: 1px solid #2a2d42;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#anilistConnectBtn:hover {
    background-color: #252a40;
    border-color: #4b3fa8;
    color: #f0f1f5;
}

QMenu#anilistAccountMenu {
    background-color: #0f1118;
    border: 1px solid #252a40;
    border-radius: 8px;
    padding: 6px 0;
}

QMenu#anilistAccountMenu::item {
    padding: 8px 22px;
    color: #c7cbd9;
}

QMenu#anilistAccountMenu::item:selected {
    background-color: #252a40;
    color: #f0f1f5;
}

QMenu#anilistAccountMenu::item:disabled {
    color: #7c6af7;
    font-weight: 700;
}

QMenu#animeLinkMenu {
    background-color: #0f1118;
    border: 1px solid #252a40;
    border-radius: 8px;
    padding: 6px 0;
}

QMenu#animeLinkMenu::item {
    padding: 8px 20px;
    color: #c7cbd9;
}

QMenu#animeLinkMenu::item:selected {
    background-color: #252a40;
    color: #f0f1f5;
}

QPushButton#cardLinkBtn {
    background-color: rgba(6, 8, 16, 0.92);
    color: #a594f9;
    border: 1px solid #4b3fa8;
    border-radius: 13px;
    font-size: 12px;
    font-weight: 700;
    padding: 0;
}

QPushButton#cardLinkBtn:hover {
    background-color: #252a40;
    color: #f0f1f5;
    border-color: #7c6af7;
}

QFrame#detailScrim {
    background-color: rgba(0, 0, 0, 0.45);
}

QPushButton#dangerBtn {
    background-color: transparent;
    color: #f87171;
    border: 1px solid #3a1a1a;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#dangerBtn:hover {
    background-color: #2a1010;
    border-color: #f87171;
}

QPushButton#iconBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px;
    color: #4a5070;
    font-size: 16px;
    min-height: 28px;
}

QPushButton#iconBtn:hover {
    background-color: #151929;
    color: #9da5c0;
}

/* ── Tab bar ─────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: transparent;
    color: #4a5070;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #a594f9;
    border-bottom-color: #7c6af7;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #9da5c0;
}

/* ── Combo box ───────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #9da5c0;
    padding: 7px 12px;
    font-size: 12px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #2e3354;
}

QComboBox:focus {
    border-color: #4b3fa8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #131620;
    border: 1px solid #2a2d42;
    border-radius: 7px;
    color: #9da5c0;
    selection-background-color: #1e1847;
    selection-color: #a594f9;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 4px;
}

/* ── Spinbox ─────────────────────────────────────────────────────────────── */
QSpinBox {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #e2e4ec;
    padding: 6px 10px;
    font-size: 13px;
}

QSpinBox:focus {
    border-color: #4b3fa8;
}

/* ── Line edit ───────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #e2e4ec;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #4b3fa8;
}

QLineEdit:focus {
    border-color: #4b3fa8;
}

/* ── Text edit ───────────────────────────────────────────────────────────── */
QTextEdit {
    background-color: #131620;
    border: 1px solid #1e2130;
    border-radius: 7px;
    color: #9da5c0;
    padding: 8px;
    font-size: 12px;
    selection-background-color: #4b3fa8;
}

QTextEdit:focus {
    border-color: #4b3fa8;
}

/* ── Checkboxes ──────────────────────────────────────────────────────────── */
QCheckBox {
    color: #9da5c0;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2a2d42;
    border-radius: 4px;
    background-color: #131620;
}

QCheckBox::indicator:checked {
    background-color: #4b3fa8;
    border-color: #4b3fa8;
}

QCheckBox::indicator:hover {
    border-color: #4b3fa8;
}

/* ── Tooltip ─────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1a1d28;
    color: #c7cbd9;
    border: 1px solid #2a2d42;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Dialog ──────────────────────────────────────────────────────────────── */
QDialog {
    background-color: #0f1118;
}

QLabel#dialogTitle {
    font-size: 17px;
    font-weight: 700;
    color: #f0f1f5;
}

QLabel#dialogSubtitle {
    font-size: 13px;
    color: #4a5070;
}

/* Settings dialog */
QDialog#settingsDialog {
    background-color: #0d0f14;
}

QWidget#settingsNav {
    background-color: #090b10;
    border-right: 1px solid #1e2130;
    min-width: 204px;
    max-width: 204px;
}

QWidget#settingsBody {
    background-color: #0d0f14;
}

QLabel#settingsNavBrand {
    font-size: 18px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: 1px;
}

QLabel#settingsNavCaption,
QLabel#settingsNavVersion {
    font-size: 12px;
    color: #626a80;
}

QPushButton#settingsNavBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: #8a91a6;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 9px 11px;
}

QPushButton#settingsNavBtn:hover {
    background-color: #11141d;
    border-color: #202436;
    color: #d5d8e4;
}

QPushButton#settingsNavBtn[active="true"] {
    background-color: #151928;
    border-color: #2c3350;
    color: #f2f3f8;
    font-weight: 600;
}

QLabel#settingsTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f0f1f5;
}

QLabel#settingsSubtitle,
QLabel#settingsPageSubtitle,
QLabel#settingsBodyText {
    font-size: 13px;
    color: #8a91a6;
    line-height: 1.55;
}

QLabel#settingsPageTitle {
    font-size: 18px;
    font-weight: 700;
    color: #f0f1f5;
}

QFrame#settingsCard {
    background-color: #111420;
    border: 1px solid #1e2235;
    border-radius: 8px;
}

QLabel#settingsCardTitle {
    font-size: 13px;
    font-weight: 700;
    color: #dfe2ec;
}

QLabel#settingsHelperText,
QLabel#settingsMutedText {
    font-size: 12px;
    color: #626a80;
}

QLabel#settingsValueText {
    font-size: 13px;
    color: #c7cbd9;
    font-weight: 600;
}

QLabel#settingsGoodText {
    font-size: 13px;
    color: #34d399;
    font-weight: 600;
}

QLabel#settingsBadText {
    font-size: 13px;
    color: #f87171;
    font-weight: 600;
}

QLabel#settingsPathText {
    background-color: #0d0f14;
    border: 1px solid #1e2235;
    border-radius: 6px;
    color: #8a91a6;
    font-family: "Consolas", "JetBrains Mono", monospace;
    font-size: 11px;
    padding: 8px 10px;
}

QLabel#settingsAboutName {
    font-size: 24px;
    font-weight: 700;
    color: #f0f1f5;
}

/* ── Stats cards ─────────────────────────────────────────────────────────── */
QFrame#statCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
    padding: 6px;
    min-height: 64px;
}

QLabel#statValue {
    font-size: 26px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.5px;
    min-height: 32px;
}

QLabel#statLabel {
    font-size: 11px;
    color: #4a5070;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

/* ── Discover card ───────────────────────────────────────────────────────── */
QFrame#discoverCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
}

QFrame#discoverCard:hover {
    border-color: #2e3354;
}

/* ── Separator ───────────────────────────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #1a1d28;
}

/* ── Splitter ────────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #1a1d28;
    width: 1px;
}

/* ── Message box ─────────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #0f1118;
}

QMessageBox QLabel {
    color: #e2e4ec;
    font-size: 13px;
}


/* ── Discover card buttons — guaranteed readable ────────────────────────── */
QFrame#discoverCard QPushButton {
    min-width: 52px !important;
    min-height: 26px !important;
    padding: 5px 14px !important;
    font-size: 11px;
    border-radius: 6px;
}

/* ── Library stat card values always visible ─────────────────────────────── */
QFrame#statCard QLabel {
    color: inherit;
}

/* Apply btn fix */
QPushButton#secondaryBtn {
    color: #c7cbd9 !important;
}
QPushButton#filterPill {
    color: #9da5c0 !important;
}

/* ── Progress bar: unwatched alert state ─────────────────────────────────── */
QProgressBar[status="alert"]::chunk {
    background-color: #f87171;
    border-radius: 3px;
}

/* ── Cover overlay badges ────────────────────────────────────────────────── */
QLabel#coverScoreBadge {
    background-color: rgba(18, 14, 40, 0.86);
    color: #c4b8ff;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 2px;
    border: 1px solid rgba(124, 106, 247, 0.45);
}

QLabel#coverEpBadge {
    background-color: rgba(18, 14, 40, 0.86);
    color: #e2e4ec;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 2px;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QLabel#coverBehindBadge {
    background-color: rgba(22, 16, 0, 0.90);
    color: #fbbf24;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 2px;
    border: 1px solid rgba(251, 191, 36, 0.40);
}

/* ── Behind filter pill — amber tint, set via objectName ────────────────── */
QPushButton#filterPillBehind {
    background-color: #1a1500;
    border: 1.5px solid #78560a;
    border-radius: 14px;
    color: #d97706;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 18px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#filterPillBehind:hover {
    background-color: #221b00;
    border-color: #b45309;
    color: #fbbf24;
}

QPushButton#filterPillBehind[active="true"] {
    background-color: #2a2000;
    border-color: #fbbf24;
    color: #fde68a;
    font-weight: 600;
}

/* ── Section headers in grouped library view ────────────────────────────── */
QLabel#libSectionHeader {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    background: transparent;
    padding: 16px 0 8px 0;
    color: #4a5070;
}

QFrame#statsPageCard {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
}


/* ── Hall of Fame — Gallery / Cinematic ──────────────────────────────────── */

/* Full-bleed blurred backdrop + scrim (behind everything on the page) */
QLabel#hofBackdropImage {
    background-color: #0a0c10;
}

QWidget#hofBackdropScrim {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(10,12,18,0.88),
        stop:0.5 rgba(10,12,18,0.94),
        stop:1 rgba(10,12,18,1.0)
    );
}

/* Champion banner — the big cinematic hero at the top of Shelves view */
QFrame#hofChampionBanner {
    background-color: rgba(17,20,32,0.72);
    border: 1.5px solid #fbbf243d;
    border-radius: 16px;
}

QFrame#hofChampionBanner:hover {
    border-color: #fbbf2470;
}

/* Tier shelf — a horizontal-scrolling row of posters */
QScrollArea#hofShelfScroll {
    background: transparent;
    border: none;
}

QScrollArea#hofShelfScroll QScrollBar:horizontal {
    background: rgba(10,12,18,0.4);
    height: 7px;
    border-radius: 3px;
    margin: 0;
}

QScrollArea#hofShelfScroll QScrollBar::handle:horizontal {
    background: #2a2d42;
    border-radius: 3px;
    min-width: 30px;
}

QScrollArea#hofShelfScroll QScrollBar::handle:horizontal:hover {
    background: #4b3fa8;
}

QPushButton#shelfNavBtn {
    background-color: rgba(10,12,18,0.7);
    border: 1px solid #2a2d42;
    border-radius: 16px;
    color: #c7cbd9;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#shelfNavBtn:hover {
    background-color: #1a1e2e;
    border-color: #4b3fa8;
    color: #f0f1f5;
}

/* Poster card — shared by Shelves and Wall view */
QFrame#hofPosterCard {
    background-color: #111420;
    border: none;
    border-radius: 10px;
}

QFrame#hofPosterCard:hover {
    border: 2px solid #4b3fa8;
}

/* Cinematic full-screen detail overlay */
QWidget#hofOverlayScrim {
    background-color: rgba(6,7,12,0.86);
}

QFrame#hofOverlayPanel {
    background-color: #12141d;
    border: 1px solid #262b45;
    border-radius: 18px;
}

QPushButton#overlayCloseBtn {
    background-color: rgba(10,12,18,0.7);
    border: 1px solid #2a2d42;
    border-radius: 18px;
    color: #c7cbd9;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#overlayCloseBtn:hover {
    background-color: #2a1010;
    border-color: #f87171;
    color: #f87171;
}

QPushButton#overlayNavBtn {
    background-color: rgba(10,12,18,0.7);
    border: 1px solid #2a2d42;
    border-radius: 22px;
    color: #c7cbd9;
    font-size: 20px;
    font-weight: 700;
}

QPushButton#overlayNavBtn:hover {
    background-color: #1a1e2e;
    border-color: #4b3fa8;
    color: #f0f1f5;
}

/* ── Unified stat strip (Statistics page overview + heatmap section) ─────── */
QFrame#statStrip {
    background-color: #111420;
    border: 1px solid #1a1d28;
    border-radius: 10px;
}

QFrame#statStripDivider {
    background-color: #1a1d28;
    border: none;
    max-width: 1px;
    min-width: 1px;
}

QLabel#statStripValue {
    font-size: 25px;
    font-weight: 700;
    color: #f0f1f5;
    letter-spacing: -0.4px;
    background: transparent;
}

QLabel#statStripLabel {
    font-size: 11px;
    color: #4a5070;
    font-weight: 600;
    letter-spacing: 0.2px;
    background: transparent;
}

QLabel#statStripTrend {
    font-size: 11px;
    color: #7c6af7;
    font-weight: 600;
    background: transparent;
}

/* ── Tier filter chips (Hall of Fame) — active state reuses filterPill ──── */
QPushButton#tierFilterPill[active="true"] {
    font-weight: 700;
}

/* ── Statistics — Wrapped-style recap slides ─────────────────────────────── */

/* Base "slide" — accent tint background/border is set per-instance in Python
   (each slide carries its own color), this just supplies shared geometry. */
QFrame#statsSlide {
    border-radius: 18px;
}

QFrame#statsRecapSlide {
    background-color: rgba(124,106,247,0.10);
    border: 1px solid rgba(124,106,247,0.30);
    border-radius: 18px;
}

QLabel#recapHeadline {
    font-size: 21px;
    font-weight: 700;
    color: #f0f1f5;
    line-height: 1.55;
    background: transparent;
}

QLabel#slideEyebrow {
    font-size: 12px;
    font-weight: 700;
    color: #8a91a6;
    background: transparent;
}

QLabel#slideBigNumber {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -1px;
    background: transparent;
}



/* ── New-season spotlight ─────────────────────────────────────────────────── */
QLabel#spotlightBadge {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 6px;
    padding: 4px 9px;
}

QLabel#spotlightPager {
    color: #e2e4ec;
    font-size: 11px;
    font-weight: 600;
    background-color: rgba(8, 10, 16, 0.72);
    border-radius: 6px;
    padding: 4px 8px;
}

QPushButton#spotlightChip {
    background-color: rgba(8, 10, 16, 0.72);
    color: #e2e4ec;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 13px;
    font-size: 13px;
    font-weight: 700;
    padding: 0;
}

QPushButton#spotlightChip:hover {
    background-color: rgba(75, 63, 168, 0.85);
    border-color: rgba(165, 148, 249, 0.60);
}

QLabel#spotlightTitle {
    color: #f0f1f5;
    font-size: 17px;
    font-weight: 700;
}

QLabel#spotlightMeta {
    color: #9da5c0;
    font-size: 11px;
    font-weight: 500;
}

QLabel#spotlightWhy {
    font-size: 12px;
}

QLabel#spotlightWhen {
    font-size: 11px;
    font-weight: 700;
    border-radius: 7px;
    padding: 5px 10px;
}

QLabel#spotlightSynopsis {
    color: #8890ab;
    font-size: 12px;
}

QPushButton#spotlightMore {
    background-color: #131620;
    color: #9da5c0;
    border: 1px solid #1e2130;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    padding: 0;
}

QPushButton#spotlightMore:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #e2e4ec;
}

QMenu#spotlightMenu {
    background-color: #0f1118;
    border: 1px solid #252a40;
    border-radius: 8px;
    padding: 6px 0;
}

QMenu#spotlightMenu::item {
    padding: 8px 20px;
    color: #c7cbd9;
}

QMenu#spotlightMenu::item:selected {
    background-color: #252a40;
    color: #f0f1f5;
}

QLabel#coverNewSeasonBadge {
    background-color: rgba(40, 28, 4, 0.92);
    color: #fbbf24;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 2px;
    border: 1px solid rgba(251, 191, 36, 0.55);
}

QLabel#coverNewSeasonBadge:hover {
    background-color: rgba(70, 48, 6, 0.95);
}

/* ── Plan-to-Watch detail sections ────────────────────────────────────────── */
QLabel#plannedReleaseMain {
    color: #f0f1f5;
    font-size: 16px;
    font-weight: 700;
}

QLabel#plannedReleaseCount {
    color: #c4b8ff;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#plannedReleaseHint,
QLabel#plannedEmpty {
    color: #7b84a3;
    font-size: 12px;
}

QLabel#plannedFactKey {
    color: #5c6482;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding-top: 2px;
}

QLabel#plannedFactValue {
    color: #e2e4ec;
    font-size: 12px;
    font-weight: 500;
}

QLabel#plannedCharName {
    color: #e2e4ec;
    font-size: 10px;
    font-weight: 600;
}

QLabel#plannedCharRole {
    color: #5c6482;
    font-size: 9px;
    font-weight: 600;
}

/* ── Completed timeline ───────────────────────────────────────────────────── */
QPushButton#sectionHeaderBtn {
    background: transparent;
    border: none;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 6px 2px;
    text-align: left;
}

QPushButton#sectionHeaderBtn:hover {
    color: #e2e4ec;
}

QLabel#sectionHeaderRule {
    background-color: #1a1d28;
}

QPushButton#sectionHeaderAction {
    background-color: transparent;
    color: #7b84a3;
    border: 1px solid #1e2130;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
}

QPushButton#sectionHeaderAction:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #e2e4ec;
}

QLabel#completedToolbarTitle {
    color: #e2e4ec;
    font-size: 13px;
    font-weight: 700;
}

QLabel#completedToolbarHint {
    color: #5c6482;
    font-size: 11px;
}

QPushButton#archivedToggle {
    background-color: #131620;
    color: #9da5c0;
    border: 1px solid #1e2130;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
}

QPushButton#archivedToggle:hover {
    background-color: #1a1e2e;
    border-color: #2e3354;
    color: #e2e4ec;
}

QPushButton#archivedToggle[active="true"] {
    background-color: #4b3fa8;
    border-color: #4b3fa8;
    color: #ffffff;
}

QPushButton#archivedToggle:disabled {
    color: #3a3f55;
}

/* ── Completed detail sections ─────────────────────────────────────────────── */
QLabel#completedStamp {
    color: #34d399;
    background-color: rgba(6, 34, 25, 0.95);
    border: 1px solid rgba(52, 211, 153, 0.45);
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 4px 10px;
}

QLabel#archivedChip {
    color: #9da5c0;
    background-color: #151821;
    border: 1px solid #2a2f45;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 4px 10px;
}

QFrame#statTile {
    background-color: #0d1019;
    border: 1px solid #1a1e2e;
    border-radius: 8px;
}

QLabel#statTileValue {
    color: #f0f1f5;
    font-size: 15px;
    font-weight: 700;
}

QLabel#statTileLabel {
    color: #5c6482;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#verdictYou {
    color: #fbbf24;
    font-size: 22px;
    font-weight: 800;
}

QLabel#verdictCommunity {
    color: #c4b8ff;
    font-size: 22px;
    font-weight: 800;
}

QLabel#verdictLine {
    color: #c7cbd9;
    font-size: 12px;
}

QLabel#galleryCaption {
    color: #9da5c0;
    font-size: 11px;
    font-weight: 600;
}

QLabel#badgeDropped {
    background-color: rgba(42, 14, 20, 0.94);
    color: #f0a3ad;
    border: 1px solid rgba(240, 120, 135, 0.45);
    border-radius: 4px;
    font-size: 9px;
    font-weight: 800;
    padding: 2px 8px;
    letter-spacing: 0.8px;
}

/* ── Dropped detail section ───────────────────────────────────────────────── */
QLabel#droppedStamp {
    color: #f0a3ad;
    background-color: rgba(42, 14, 20, 0.95);
    border: 1px solid rgba(181, 72, 90, 0.6);
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 4px 10px;
}

QProgressBar#droppedBar {
    background-color: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 3px;
}

QProgressBar#droppedBar::chunk {
    background-color: #b5485a;
    border-radius: 3px;
}

QPlainTextEdit#dropReason {
    background-color: #0d1019;
    color: #e2e4ec;
    border: 1px solid #1e2236;
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 12px;
}

QPlainTextEdit#dropReason:focus {
    border-color: #4b3fa8;
}

/* ── Rewatches ─────────────────────────────────────────────────────────────── */
QPushButton#rewatchStep {
    background-color: #131620;
    color: #e2e4ec;
    border: 1px solid #1e2130;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    padding: 0;
}

QPushButton#rewatchStep:hover {
    background-color: #4b3fa8;
    border-color: #4b3fa8;
}

QPushButton#rewatchStep:disabled {
    color: #3a3f55;
}

QLabel#rewatchProgress {
    color: #c4b8ff;
    font-size: 14px;
    font-weight: 700;
}

QProgressBar#rewatchBar {
    background-color: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 3px;
}

QProgressBar#rewatchBar::chunk {
    background-color: #7c6af7;
    border-radius: 3px;
}

/* ── Kinema: movies ────────────────────────────────────────────────────────── */
QLabel#movieStamp {
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 4px 10px;
    color: #fbbf24;
    background-color: rgba(40, 28, 4, 0.95);
    border: 1px solid rgba(251, 191, 36, 0.45);
}

QLabel#movieStamp[kind="watched"] {
    color: #34d399;
    background-color: rgba(6, 34, 25, 0.95);
    border: 1px solid rgba(52, 211, 153, 0.45);
}

QLabel#movieStamp[kind="watchlist"] {
    color: #c4b8ff;
    background-color: rgba(24, 18, 56, 0.95);
    border: 1px solid rgba(165, 148, 249, 0.45);
}

QLabel#movieCountdown {
    color: #fbbf24;
    font-size: 22px;
    font-weight: 800;
}

QLabel#providerChip,
QLabel#providerChipStream {
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    color: #c7cbd9;
    background-color: #151929;
    border: 1px solid #252a40;
}

QLabel#providerChipStream {
    color: #bbf7d0;
    background-color: rgba(6, 34, 25, 0.9);
    border: 1px solid rgba(52, 211, 153, 0.45);
}

QLabel#collectionNum {
    color: #5c6482;
    font-size: 12px;
    font-weight: 700;
}

QLabel#collectionTag,
QLabel#collectionTagThis {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 5px;
    padding: 3px 7px;
    color: #9da5c0;
    background-color: #151929;
}

QLabel#collectionTagThis {
    color: #fbbf24;
    background-color: rgba(40, 28, 4, 0.95);
}

QLabel#releaseTimeline {
    font-size: 12px;
    padding-top: 4px;
}

QLabel#browserReason {
    color: #fbbf24;
    font-size: 11px;
    font-weight: 700;
}

/* ── Sidebar library headers (Miroku / Kinema) ────────────────────────────── */
QLabel#sidebarBrandName {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#sidebarBrandSub {
    color: #4a5070;
    font-size: 10px;
    font-weight: 600;
}

/* ── Kinema Discover: Movies | TV shows switch ─────────────────────────── */
QPushButton#kindSwitch {
    background: transparent;
    color: #8c93ad;
    border: 1px solid #262a3a;
    border-radius: 15px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#kindSwitch:hover { color: #e2e4ec; border-color: #3a3f55; }
QPushButton#kindSwitch[active="true"] {
    background: rgba(56, 189, 248, 0.12);
    color: #e6f6ff;
    border-color: #38bdf8;
}

/* ── Kinema TV: detail panel ───────────────────────────────────────────── */
QLabel#tvStamp {
    background: rgba(56, 189, 248, 0.12); color: #bae6fd;
    border: 1px solid #38bdf8; border-radius: 5px;
    padding: 3px 10px; font-size: 10px; font-weight: 800; letter-spacing: 1px;
}
QLabel#tvStamp[ws="planned"]   { background: rgba(157,143,255,0.10); color: #d7d2ff; border-color: #9d8fff; }
QLabel#tvStamp[ws="completed"] { background: rgba(52,211,153,0.10); color: #bbf7d0; border-color: #34d399; }
QLabel#tvStamp[ws="dropped"]   { background: rgba(181,72,90,0.12); color: #f0a3ad; border-color: #b5485a; }
QLabel#tvShowState { color: #8c93ad; font-size: 11px; font-weight: 600; padding-left: 6px; }
QWidget#tvProgressTrack { background: #1c2030; border-radius: 3px; }
QWidget#tvProgressFill  { background: #38bdf8; border-radius: 3px; }
QLabel#tvNextAir { color: #7dd3fc; font-size: 12px; font-weight: 600; }

QPushButton#tvSeasonTab {
    background: #141724; color: #8c93ad; border: 1px solid #23273a;
    border-radius: 13px; padding: 4px 12px; font-size: 11px; font-weight: 700;
}
QPushButton#tvSeasonTab:hover { color: #e2e4ec; border-color: #3a3f55; }
QPushButton#tvSeasonTab[active="true"] {
    background: rgba(56, 189, 248, 0.14); color: #e6f6ff; border-color: #38bdf8;
}
QLabel#tvSeasonTitle { color: #f0f1f6; font-size: 14px; font-weight: 700; }
QPushButton#tvStar {
    background: transparent; border: none; color: #3a3f55; font-size: 14px; padding: 0;
}
QPushButton#tvStar:hover { color: #fde68a; }
QPushButton#tvStar[on="true"] { color: #fbbf24; }

QWidget#tvEpRow, QWidget#tvEpRowNext { border-radius: 7px; background: transparent; }
QWidget#tvEpRow:hover { background: #151827; }
QWidget#tvEpRowNext { background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.35); }
QPushButton#tvEpTick {
    background: transparent; border: 1.5px solid #3a3f55; border-radius: 12px;
    color: #0b0d12; font-size: 12px; font-weight: 900; padding: 0;
}
QPushButton#tvEpTick:hover { border-color: #38bdf8; }
QPushButton#tvEpTick[watched="true"] { background: #38bdf8; border-color: #38bdf8; }
QPushButton#tvEpTick:disabled { border: 1.5px dashed #2a2e40; }
QLabel#tvEpNum { color: #6b7391; font-size: 11px; font-weight: 700; }
QLabel#tvEpName { color: #dfe2ec; font-size: 12px; }
QLabel#tvEpNameDim { color: #6b7391; font-size: 12px; }
QLabel#tvEpRating { color: #fbbf24; font-size: 11px; font-weight: 700; }
QLabel#tvEpDate { color: #5c6482; font-size: 11px; }
QLabel#tvEpAirs { color: #7dd3fc; font-size: 11px; font-weight: 600; }

/* ── Miroku: Watching section (Kinema layout, indigo) ──────────────────── */
QLabel#animeStamp {
    background: rgba(139, 123, 255, 0.14); color: #e0dbff;
    border: 1px solid #8b7bff; border-radius: 5px;
    padding: 3px 10px; font-size: 10px; font-weight: 800; letter-spacing: 1px;
}
QWidget#animeProgressFill { background: #8b7bff; border-radius: 3px; }
QLabel#animeNextAir { color: #b8adff; font-size: 12px; font-weight: 600; }
QLabel#animeEpAirs { color: #b8adff; font-size: 11px; font-weight: 600; }
QPushButton#animeEpTick {
    background: transparent; border: 1.5px solid #3a3f55; border-radius: 12px;
    color: #0b0d12; font-size: 12px; font-weight: 900; padding: 0;
}
QPushButton#animeEpTick:hover { border-color: #8b7bff; }
QPushButton#animeEpTick[watched="true"] { background: #8b7bff; border-color: #8b7bff; }
QPushButton#animeEpTick:disabled { border: 1.5px dashed #2a2e40; }
QPushButton#animeBlockTab {
    background: #141724; color: #8c93ad; border: 1px solid #23273a;
    border-radius: 13px; padding: 4px 12px; font-size: 11px; font-weight: 700;
}
QPushButton#animeBlockTab:hover { color: #e2e4ec; border-color: #3a3f55; }
QPushButton#animeBlockTab[active="true"] {
    background: rgba(139, 123, 255, 0.16); color: #f0edff; border-color: #8b7bff;
}

/* Browser preview: the "Because you…" line takes the library colour */
QLabel#browserReason[kind="tv"]    { color: #7dd3fc; }
QLabel#browserReason[kind="anime"] { color: #b8adff; }

/* Quick links: one-click label presets */
QPushButton#linkPreset {
    background: #141724; color: #b7bdd3; border: 1px solid #262a3a;
    border-radius: 12px; padding: 3px 10px; font-size: 11px;
}
QPushButton#linkPreset:hover { color: #f0f1f6; border-color: #8b7bff; background: rgba(139,123,255,0.10); }

/* ── Raikō Home ──────────────────────────────────────────────────────────── */
QLabel#homeSummary { color: #9da5c0; font-size: 13px; }
QLabel#homeSection {
    color: #8c93ad; font-size: 11px; font-weight: 800; letter-spacing: 1.6px; padding-top: 14px;
}
QLabel#homeDay { color: #c7cbe0; font-size: 12px; font-weight: 700; padding: 8px 0 2px 2px; }
QWidget#homeUpRow { background: #11131c; border: 1px solid #1c2030; border-radius: 10px; }
QWidget#homeUpRow:hover { background: #161a27; border-color: #2a3150; }
QLabel#homeUpTitle { color: #eceef6; font-size: 13px; font-weight: 600; }
QLabel#homeUpLabel { font-size: 11px; font-weight: 600; }
QLabel#homeUpWhen { color: #8c93ad; font-size: 11px; font-weight: 600; }
QPushButton#homeWatchedBtn {
    background: rgba(8, 9, 14, 0.82); color: #f0f1f6; border: 1px solid rgba(255,255,255,0.18);
    border-radius: 9px; padding: 5px 11px; font-size: 11px; font-weight: 700;
}
QPushButton#homeWatchedBtn:hover { background: #34d399; color: #062016; border-color: #34d399; }

/* ── Raikō Home v2 ───────────────────────────────────────────────────────── */
QLabel#homeHello { color: #f4f5fa; font-size: 24px; font-weight: 800; }
QLabel#homeDate { color: #7f87a3; font-size: 12px; }
QLineEdit#homeSearch {
    background: #12141d; border: 1px solid #23273a; border-radius: 20px;
    padding: 0 16px; color: #e8eaf2; font-size: 12px;
}
QLineEdit#homeSearch:focus { border-color: #8b7bff; background: #151827; }
QLabel#heroKicker { font-size: 11px; font-weight: 800; letter-spacing: 1.6px; background: transparent; }
QLabel#heroTitle { color: #ffffff; font-size: 30px; font-weight: 800; background: transparent; }
QLabel#heroNext { color: #dfe2ee; font-size: 14px; font-weight: 600; background: transparent; }
QLabel#heroBlurb { color: #a8aec6; font-size: 12px; background: transparent; }
QPushButton#heroPrimary {
    border: none; border-radius: 11px; padding: 0 20px; font-size: 13px; font-weight: 800;
}
QPushButton#heroSecondary {
    background: rgba(255,255,255,0.10); color: #f0f1f6; border: 1px solid rgba(255,255,255,0.18);
    border-radius: 11px; padding: 0 18px; font-size: 13px; font-weight: 700;
}
QPushButton#heroSecondary:hover { background: rgba(255,255,255,0.18); }
QWidget#homeStat { background: #11131c; border: 1px solid #1c2030; border-radius: 12px; }
QLabel#homeStatValue { font-size: 22px; font-weight: 800; background: transparent; }
QLabel#homeStatLabel { color: #7f87a3; font-size: 9px; font-weight: 800; letter-spacing: 1.2px; background: transparent; }
QLabel#homeSection { color: #eef0f7; font-size: 17px; font-weight: 800; }
QLabel#homeEmpty { color: #7f87a3; font-size: 12px; }
QPushButton#cardTick {
    background: #34d399; color: #062016; border: none; border-radius: 17px;
    font-size: 15px; font-weight: 900; padding: 0;
}
QWidget#homeDayCol, QWidget#homeDayColToday {
    background: #0f1119; border: 1px solid #1a1d2a; border-radius: 12px;
}
QWidget#homeDayColToday { background: #13122a; border-color: #3b3470; }
QLabel#homeDayTitle { color: #eef0f7; font-size: 12px; font-weight: 800; background: transparent; }
QLabel#homeDaySub { color: #6b7391; font-size: 10px; background: transparent; }
QLabel#homeDayEmpty { color: #3d4359; font-size: 11px; background: transparent; }

/* Raikō sidebar brand */
QLabel#appLogoName { color: #f4f5fa; font-size: 18px; font-weight: 800; letter-spacing: 0.5px; }

/* Library cards: hover quick action */
QPushButton#cardQuickTick {
    background: rgba(8, 9, 14, 0.82); color: #f4f5fa; border: 1px solid rgba(255,255,255,0.22);
    border-radius: 17px; font-size: 15px; font-weight: 900; padding: 0;
}
QPushButton#cardQuickTick:hover { background: #34d399; color: #062016; border-color: #34d399; }

/* ── Raikō onboarding ────────────────────────────────────────────────────── */
QWidget#welcomeCard { background: #0f1119; border: 1px solid #262a3d; border-radius: 22px; }
QLabel#welcomeHead { color: #f4f5fa; font-size: 24px; font-weight: 800; background: transparent; }
QLabel#welcomeSub { color: #a8aec6; font-size: 13px; background: transparent; }
QWidget#welcomeTile { background: #141724; border: 1px solid #22263a; border-radius: 14px; }
QPushButton#welcomeGo {
    background: #8b7bff; color: #0b0d12; border: none; border-radius: 12px;
    padding: 0 22px; font-size: 13px; font-weight: 800;
}
QPushButton#welcomeGo:hover { background: #a294ff; }
QPushButton#welcomeSkip { background: transparent; color: #7f87a3; border: none; font-size: 12px; padding: 0 8px; }
QPushButton#welcomeSkip:hover { color: #e2e4ec; }
QWidget#tourCard { background: #12142a; border: 1px solid #3b3470; border-radius: 16px; }
QLabel#tourCounter { color: #8b7bff; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; background: transparent; }
QLabel#tourDots { color: #4a4f7a; font-size: 9px; letter-spacing: 2px; background: transparent; }
QLabel#tourTitle { color: #f4f5fa; font-size: 16px; font-weight: 800; background: transparent; }
QLabel#tourDesc { color: #a8aec6; font-size: 12px; background: transparent; }
QPushButton#tourNext {
    background: #8b7bff; color: #0b0d12; border: none; border-radius: 9px;
    padding: 7px 18px; font-size: 12px; font-weight: 800;
}
QPushButton#tourNext:hover { background: #a294ff; }
QPushButton#tourBack {
    background: transparent; color: #c7cbe0; border: 1px solid #2f3450; border-radius: 9px;
    padding: 7px 14px; font-size: 12px;
}
QPushButton#tourSkip { background: transparent; color: #6b7391; border: none; font-size: 11px; }
QPushButton#tourSkip:hover { color: #c7cbe0; }
QLabel#homeCaughtUp {
    color: #bbf7d0; background: rgba(52,211,153,0.08); border: 1px solid rgba(52,211,153,0.25);
    border-radius: 12px; padding: 14px 18px; font-size: 13px; font-weight: 600;
}

/* Home spotlight carousel */
QLabel#spotReason { color: #e8eaf2; font-size: 12px; font-weight: 600; background: rgba(8,9,14,0.55);
                    border-radius: 8px; padding: 4px 10px; }
QPushButton#spotArrow {
    background: rgba(8, 9, 14, 0.62); color: #f0f1f6; border: 1px solid rgba(255,255,255,0.18);
    border-radius: 18px; font-size: 18px; font-weight: 700; padding: 0 0 3px 0;
}
QPushButton#spotArrow:hover { background: rgba(255,255,255,0.16); }

/* ── This week popover ───────────────────────────────────────────────────── */
QPushButton#popClose {
    background: rgba(8,9,14,0.7); color: #c7cbe0; border: 1px solid rgba(255,255,255,0.12);
    border-radius: 13px; font-size: 11px; padding: 0;
}
QPushButton#popClose:hover { color: #ffffff; background: rgba(255,255,255,0.12); }
QLabel#popTitle { color: #f4f5fa; font-size: 17px; font-weight: 800; background: transparent; }
QLabel#popHeadline { font-size: 13px; font-weight: 700; background: transparent; }
QLabel#popCountdown { color: #e8eaf2; font-size: 22px; font-weight: 800; background: transparent; }
QLabel#popFactKey { color: #6b7391; font-size: 9px; font-weight: 800; letter-spacing: 1.2px; background: transparent; }
QLabel#popFactValue { color: #dfe2ee; font-size: 12px; background: transparent; }
QLabel#popBlurb { color: #9da5c0; font-size: 12px; background: transparent; }
QPushButton#popPrimary {
    border: none; border-radius: 10px; padding: 9px 18px; font-size: 12px; font-weight: 800;
}
QPushButton#popSecondary {
    background: rgba(255,255,255,0.08); color: #f0f1f6; border: 1px solid rgba(255,255,255,0.16);
    border-radius: 10px; padding: 9px 16px; font-size: 12px; font-weight: 700;
}
QPushButton#popSecondary:hover { background: rgba(255,255,255,0.16); }

/* ── Hall of Fame ────────────────────────────────────────────────────────── */
QDialog#hallDialog { background: #0f111a; }
QLabel#hallTitle { color: #f6f7fb; font-size: 30px; font-weight: 900; }
QLabel#hallKicker { font-size: 10px; font-weight: 900; letter-spacing: 2px; background: transparent; }
QLabel#hallAsk { color: #f4f5fa; font-size: 22px; font-weight: 800; }
QLabel#hallAskSub { color: #8c93ad; font-size: 12px; }
QLabel#hallVs { color: #4a5070; font-size: 18px; font-weight: 900; padding: 0 6px; }
QLabel#hallDoneRank { font-size: 84px; font-weight: 900; }
QLabel#hallHint { color: #4f5674; font-size: 10px; padding-top: 6px; }
QLabel#hallPlaqueRank { font-size: 40px; font-weight: 900; padding-right: 10px; background: transparent; }
QPushButton#hallPrimary {
    color: #0b0d12; border: none; border-radius: 10px; padding: 9px 18px; font-size: 12px; font-weight: 800;
}
QPushButton#hallPrimary:disabled { background: #2a2f45; color: #6b7391; }
QPushButton#hallGhost {
    background: rgba(255,255,255,0.06); color: #e8eaf2; border: 1px solid rgba(255,255,255,0.14);
    border-radius: 10px; padding: 8px 15px; font-size: 12px; font-weight: 700;
}
QPushButton#hallGhost:hover { background: rgba(255,255,255,0.12); }
QPushButton#hallGhost:disabled { color: #4f5674; border-color: rgba(255,255,255,0.06); }
QPushButton#hallDanger {
    background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.35);
    border-radius: 10px; padding: 8px 15px; font-size: 12px; font-weight: 700;
}
QPushButton#hallDanger:hover { background: rgba(248,113,113,0.12); }
QPushButton#hallTab {
    background: #12141d; color: #c7cbe0; border: 1px solid #23273a; border-radius: 16px;
    padding: 7px 16px; font-size: 12px; font-weight: 800;
}
QPushButton#hallTab:hover { border-color: #3a3f57; color: #ffffff; }
QPushButton#hallSeg {
    background: transparent; color: #7f87a3; border: none; border-radius: 8px;
    padding: 6px 11px; font-size: 12px; font-weight: 700;
}
QPushButton#hallSeg:hover { color: #e8eaf2; }
QPushButton#hallSeg:checked { background: #1c2030; color: #f4f5fa; }
QFrame#hallEmpty { background: #12141d; border: 1px dashed #2e3348; border-radius: 16px; }
QListWidget#hallList { background: transparent; border: none; outline: none; }
QListWidget#hallList::item { border-radius: 10px; }
QListWidget#hallList::item:hover { background: rgba(255,255,255,0.04); }
QListWidget#hallList::item:selected { background: rgba(245,196,81,0.08); }
QFrame#hallTierFrame { background: #12141d; border: 1px solid #1d2130; border-radius: 12px; }
QLabel#hallTierLabel { font-size: 22px; font-weight: 900; border-top-left-radius: 12px; border-bottom-left-radius: 12px; }
QListWidget#hallTierRow { background: transparent; border: none; outline: none; padding: 4px; }
QListWidget#hallTierRow::item { color: transparent; border-radius: 6px; }
QListWidget#hallTierRow::item:selected { background: rgba(245,196,81,0.18); }
QLabel#hallYear { color: #f5c451; font-size: 20px; font-weight: 900; padding-top: 10px; }
QLabel#hallTimeDate { color: #7f87a3; font-size: 12px; font-weight: 700; }
QLabel#hallTimeText { color: #c7cbe0; font-size: 13px; }
QTextEdit#hallField, QLineEdit#hallField {
    background: #12141d; color: #e8eaf2; border: 1px solid #23273a; border-radius: 10px;
    padding: 7px 10px; font-size: 12px;
}
QTextEdit#hallField:focus, QLineEdit#hallField:focus { border-color: #f5c451; }
QPushButton#hallTierChip {
    background: #12141d; color: #c7cbe0; border: 1px solid #2a2f45; border-radius: 7px;
    min-width: 30px; padding: 4px 8px; font-size: 11px; font-weight: 900;
}
QFrame#hallAward { background: #12141d; border: 1px solid #1f2333; border-radius: 16px; }
QFrame#hallAward:hover { border-color: #3a3424; }
QLabel#hallAwardCat { color: #f5c451; font-size: 11px; font-weight: 900; letter-spacing: 1.8px; background: transparent; }
QPushButton#hallIcon { background: transparent; color: #8c93ad; border: none; font-size: 16px; font-weight: 900; }
QPushButton#hallIcon:hover { color: #ffffff; }
QLabel#hallWinnerTag { color: #f5c451; font-size: 9px; font-weight: 900; letter-spacing: 1.4px; background: transparent; }
QLabel#hallAwardName { color: #f4f5fa; font-size: 16px; font-weight: 800; background: transparent; }
QLabel#hallParts { color: #9da5c0; font-size: 11px; background: transparent; }
QLabel#hallReason { color: #dfe2ee; font-size: 12px; font-style: italic; background: transparent; }
QLabel#hallReasonEmpty { color: #565d7a; font-size: 12px; background: transparent; }
QLabel#hallReasonEmpty:hover { color: #f5c451; }
QPushButton#hallPickEmpty {
    background: rgba(245,196,81,0.04); color: #c9a54a; border: 1px dashed #4a4130; border-radius: 12px;
    font-size: 13px; font-weight: 800;
}
QPushButton#hallPickEmpty:hover { background: rgba(245,196,81,0.10); color: #f5c451; }
QPushButton#hallRunner {
    background: #181b28; color: #c7cbe0; border: 1px solid #262a3d; border-radius: 9px;
    padding: 5px 10px; font-size: 11px; font-weight: 700; text-align: left;
}
QPushButton#hallRunner:hover { border-color: #3a3f57; }
QPushButton#hallRunnerAdd {
    background: transparent; color: #6b7391; border: 1px dashed #2e3348; border-radius: 9px;
    padding: 5px 10px; font-size: 11px; font-weight: 700;
}
QPushButton#hallRunnerAdd:hover { color: #f5c451; border-color: #4a4130; }
QWidget#hallGroupRow { background: #12141d; border: 1px solid #1f2333; border-radius: 12px; }
QWidget#hallGroupRow:hover { border-color: #f5c451; }
QListWidget#hallPickList { background: #12141d; border: 1px solid #1f2333; border-radius: 12px; color: #e3e6f0;
    font-size: 13px; outline: none; padding: 4px; }
QListWidget#hallPickList::item { padding: 9px 10px; border-radius: 8px; }
QListWidget#hallPickList::item:hover { background: rgba(245,196,81,0.10); }

QPushButton#hofBtn {
    background: rgba(245,196,81,0.10); color: #f5c451; border: 1px solid rgba(245,196,81,0.35);
    border-radius: 10px; padding: 9px 14px; font-weight: 800; text-align: left;
}
QPushButton#hofBtn:hover { background: rgba(245,196,81,0.18); }
QPushButton#hofBtn[inHall="true"] { background: #f5c451; color: #0b0d12; border-color: #f5c451; }

/* ── Status switcher (detail panel) ─────────────────────────────────────── */
QLabel#statusSwitchHead { color: #6b7391; font-size: 10px; font-weight: 800; letter-spacing: 1.6px; }
QWidget#statusSwitchTrack { background: #12141d; border: 1px solid #23273a; border-radius: 12px; }
QPushButton#statusSeg {
    background: transparent; color: #c7cbe0; border: none; border-radius: 9px;
    padding: 8px 2px; font-size: 11px; font-weight: 700;
}
QPushButton#statusSeg:hover { background: rgba(255,255,255,0.07); color: #ffffff; }
QPushButton#statusSeg[blocked="true"] { color: #454b66; }
QPushButton#statusSeg[blocked="true"]:hover { background: transparent; color: #454b66; }
QLabel#statusSwitchHint { color: #8c93ad; font-size: 11px; }

/* ── Videos & music tabs ─────────────────────────────────────────────────── */
QWidget#galleryTabs { background: #12141d; border: 1px solid #23273a; border-radius: 11px; }
QPushButton#galleryTab {
    background: transparent; color: #9da5c0; border: none; border-radius: 8px;
    padding: 7px 2px; font-size: 11px; font-weight: 700;
}
QPushButton#galleryTab:hover { color: #ffffff; background: rgba(255,255,255,0.06); }
QPushButton#galleryTab:checked { background: #2a2f45; color: #ffffff; }

/* ── Music ───────────────────────────────────────────────────────────────── */
QPushButton#musicLike, QPushButton#musicAction {
    background: rgba(255,255,255,0.06); color: #dfe2ee; border: 1px solid rgba(255,255,255,0.12);
    border-radius: 9px; padding: 6px 12px; font-size: 12px; font-weight: 700; min-width: 18px;
}
QPushButton#musicLike:hover, QPushButton#musicAction:hover { background: rgba(255,255,255,0.12); color: #ffffff; }
QPushButton#musicLike:checked { background: rgba(244,114,182,0.16); color: #f472b6; border-color: rgba(244,114,182,0.45); }
QPushButton#playerLike, QPushButton#playerAction {
    background: #1a1d28; color: #c7cbd9; border: 1px solid #2a2d42; border-radius: 6px;
    font-size: 11px; font-weight: 700; padding: 0 14px;
}
QPushButton#playerLike:checked { color: #f472b6; border-color: #6b2f52; background: #2a1624; }
QPushButton#playerLike:hover, QPushButton#playerAction:hover { background: #252a40; color: #ffffff; }
QFrame#musicRow { background: transparent; border-radius: 10px; }
QFrame#musicRow:hover { background: rgba(255,255,255,0.04); }
QLabel#musicRowNum { color: #6b7391; font-size: 13px; font-weight: 800; }
QLabel#musicRowTitle { color: #eef0f7; font-size: 13px; font-weight: 700; }
QLabel#musicRowSub { color: #8c93ad; font-size: 11px; }
QLabel#musicRowWhen { color: #6b7391; font-size: 11px; }
QLabel#musicThumb { background: #161a2a; border-radius: 6px; }
QLabel#musicRankBadge {
    color: #0b0d12; background: #f5c451; border-radius: 7px; padding: 2px 8px; font-size: 10px; font-weight: 900;
}
QListWidget#musicRankList { background: transparent; border: none; outline: none; }
QListWidget#musicRankList::item:selected { background: rgba(245,196,81,0.06); }
QProgressBar#musicProgress { background: #1a1d28; border: none; border-radius: 4px; height: 8px; }
QProgressBar#musicProgress::chunk { background: #8b7bff; border-radius: 4px; }
QPushButton#songListen {
    background: rgba(8,9,14,0.82); color: #ffffff; border: 1px solid rgba(255,255,255,0.25);
    border-radius: 10px; padding: 6px 12px; font-size: 12px; font-weight: 800;
}
QPushButton#songListen:hover { background: #8b7bff; color: #0b0d12; }
QWidget#songRow { background: #12141d; border: 1px solid #1f2333; border-radius: 12px; }
QWidget#songRow:hover { border-color: #3a3f57; }
QLabel#songRowTitle { color: #eef0f7; font-size: 13px; font-weight: 700; }

/* ── Appearance & theme preview ───────────────────────────────────────────── */
QPushButton#themePreviewBtn {
    background: rgba(8,9,14,0.85); color: #f4f5fa; border: 1px solid rgba(255,255,255,0.25);
    border-radius: 9px; padding: 5px 12px; font-size: 11px; font-weight: 800;
}
QPushButton#themePreviewBtn:hover { background: #8b7bff; color: #0b0d12; }
QPushButton#accentSwatch { font-size: 11px; font-weight: 700; color: #c7cbe0; background: #1a1d28;
    border: 1px solid #2a2d42; border-radius: 15px; }
QPushButton#accentSwatch:checked { border: 2px solid #f4f5fa; }
QWidget#previewPill { background: #12141d; border: 1px solid #2e3348; border-radius: 16px; }
QLabel#previewKicker { color: #8b7bff; font-size: 10px; font-weight: 900; letter-spacing: 1.6px; }
QLabel#previewName { color: #f4f5fa; font-size: 14px; font-weight: 800; }
QLabel#previewStep { color: #9da5c0; font-size: 11px; font-weight: 700; }
QLabel#previewCaption { color: #c7cbe0; font-size: 12px; }
QPushButton#previewNav { background: #1a1d28; color: #e8eaf2; border: 1px solid #2a2d42; border-radius: 8px;
    font-size: 14px; font-weight: 800; }
QPushButton#previewNav:disabled { color: #4a5070; }

/* ── Event banner & coach mark ───────────────────────────────────────────── */
QFrame#eventBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(139,123,255,0.16), stop:1 rgba(245,196,81,0.10));
    border: 1px solid rgba(139,123,255,0.35); border-radius: 16px;
}
QLabel#eventBannerTitle { color: #f4f5fa; font-size: 14px; background: transparent; }
QLabel#eventBannerSub { color: #9da5c0; font-size: 12px; background: transparent; }
QPushButton#eventBannerClose { background: transparent; color: #8c93ad; border: none; font-size: 13px; }
QPushButton#eventBannerClose:hover { color: #ffffff; }
QWidget#coachMark { background: #161925; border: 1px solid #8b7bff; border-radius: 14px; }
QLabel#coachText { color: #e8eaf2; font-size: 13px; background: transparent; }

QFrame#eventRow { background: #12141d; border: 1px solid #1f2333; border-radius: 12px; }
